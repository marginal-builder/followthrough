# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/followthrough

# Valkey/Redis
VALKEY_URL=redis://localhost:6379/0

# Auth
TEAM_PASSCODE=changeme
SESSION_SECRET=dev-secret-change-in-production

# Groq API (get your key from https://console.groq.com)
GROQ_API_KEY=

# Uploads
# UPLOAD_DIR=/tmp/followthrough
# MAX_UPLOAD_SIZE_MB=50